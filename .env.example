# Copy to .env and edit. Every value here is optional — the defaults shown are
# what the server uses if you leave a line out.

# --- server ---------------------------------------------------------------
PORT=8787
HOST=0.0.0.0
# Your public address. Setting an https:// value turns on secure cookies.
PUBLIC_URL=http://localhost:8787
# Set to true when running behind a reverse proxy that sets X-Forwarded-*.
TRUST_PROXY=false
LOG_LEVEL=info

# --- storage --------------------------------------------------------------
# The SQLite database and the encryption key live here.
DATA_DIR=./data
# DATABASE_PATH=./data/bookmarks.db

# 32 bytes, base64 or hex. Protects stored refresh tokens at rest.
# Generate one with: openssl rand -base64 32
# If unset, the server creates one and keeps it in DATA_DIR/encryption.key.
# ENCRYPTION_KEY=

# --- who can sign in ------------------------------------------------------
# Single-user by default: the first account to sign in claims the instance.
MULTI_USER=false
# Optional allowlist. Comma-separated handles; empty means no restriction.
# ALLOWED_HANDLES=you.bsky.social,someone.else.social

# How long a browser session lasts.
SESSION_TTL_DAYS=30

# --- syncing --------------------------------------------------------------
# How often to check for new bookmarks.
SYNC_INTERVAL_MINUTES=10
# Every Nth check is a full walk that also detects bookmarks you removed on
# Bluesky. With the defaults that is once an hour.
FULL_SYNC_EVERY=6
# Bookmarks fetched per request (max 100).
SYNC_PAGE_SIZE=100
# Pause between pages during the first backfill, to stay a polite guest.
SYNC_PAGE_DELAY_MS=120
# Consecutive already-known pages before a quick check stops early.
QUICK_SYNC_STABLE_PAGES=2
# Start a sync as soon as someone signs in.
SYNC_ON_LOGIN=true
# Turn off background syncing entirely. Manual syncs still work.
SYNC_ENABLED=true
# Permanently delete un-bookmarked posts after this many days. 0 keeps them.
PURGE_REMOVED_AFTER_DAYS=0

# --- network --------------------------------------------------------------
# Used unauthenticated, for handle suggestions and profile lookups.
APPVIEW_URL=https://public.api.bsky.app
PLC_DIRECTORY_URL=https://plc.directory
DEFAULT_PDS_URL=https://bsky.social

# --- front end ------------------------------------------------------------
# Serve the built web interface from the same process.
SERVE_WEB=true
# WEB_DIR=./web/dist
