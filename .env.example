# Copy to .env and edit:  cp .env.example .env
#
# Every value here is optional — the defaults shown are what the server uses
# if you leave a line out. Lines you leave blank fall back to the default too.
#
# Docker reads this file automatically (`docker compose up -d` picks it up from
# the project directory). No rebuild is needed after editing — the values are
# passed in at container start, so `docker compose up -d` is enough to apply.

# --- which port -----------------------------------------------------------
# DOCKER: this is the only port setting you need. It is the port on the host
# machine. Change it if 8787 is already in use. Inside the container the server
# always listens on 8787, and compose maps HOST_PORT -> 8787 for you.
HOST_PORT=8787

# FROM SOURCE (npm start) ONLY: the port the server itself binds.
# Under Docker this is ignored — set HOST_PORT above instead. Changing it here
# would make the server listen somewhere the port mapping is not pointing.
PORT=8787
HOST=0.0.0.0

# Your public address. Setting an https:// value turns on secure cookies.
# Under Docker, leave this blank and it follows HOST_PORT automatically.
# Set it explicitly when behind a reverse proxy or a real domain.
# PUBLIC_URL=http://localhost:8787
# Set to true when running behind a reverse proxy that sets X-Forwarded-*.
TRUST_PROXY=false
LOG_LEVEL=info

# --- storage --------------------------------------------------------------
# The SQLite database and the encryption key live here.
DATA_DIR=./data
# DATABASE_PATH=./data/bookmarks.db

# 32 bytes, base64 or hex. Protects stored refresh tokens at rest.
# Generate one with: openssl rand -base64 32
# If unset, the server creates one and keeps it in DATA_DIR/encryption.key.
# ENCRYPTION_KEY=

# --- who can sign in ------------------------------------------------------
# Single-user by default: the first account to sign in claims the instance.
MULTI_USER=false
# Optional allowlist. Comma-separated handles; empty means no restriction.
# ALLOWED_HANDLES=you.bsky.social,someone.else.social

# How long a browser session lasts.
SESSION_TTL_DAYS=30

# --- agent API ------------------------------------------------------------
# Requests a minute per agent token, shared across every /api/agent/v1
# endpoint. Generous by default; lower it if the instance faces the internet.
AGENT_RATE_LIMIT_PER_MINUTE=600

# --- syncing --------------------------------------------------------------
# How often to check for new bookmarks.
SYNC_INTERVAL_MINUTES=10
# Every Nth check is a full walk that also detects bookmarks you removed on
# Bluesky. With the defaults that is once an hour.
FULL_SYNC_EVERY=6
# Bookmarks fetched per request (max 100).
SYNC_PAGE_SIZE=100
# Pause between pages during the first backfill, to stay a polite guest.
SYNC_PAGE_DELAY_MS=120
# Consecutive already-known pages before a quick check stops early.
QUICK_SYNC_STABLE_PAGES=2
# Start a sync as soon as someone signs in.
SYNC_ON_LOGIN=true
# Turn off background syncing entirely. Manual syncs still work.
SYNC_ENABLED=true
# Permanently delete un-bookmarked posts after this many days. 0 keeps them.
PURGE_REMOVED_AFTER_DAYS=0

# --- network --------------------------------------------------------------
# Used unauthenticated, for handle suggestions and profile lookups.
APPVIEW_URL=https://public.api.bsky.app
PLC_DIRECTORY_URL=https://plc.directory
DEFAULT_PDS_URL=https://bsky.social

# --- front end ------------------------------------------------------------
# Serve the built web interface from the same process.
SERVE_WEB=true
# WEB_DIR=./web/dist
