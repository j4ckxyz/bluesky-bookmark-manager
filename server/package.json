{
  "name": "@bluesky-bookmarks/server",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "seed:demo": "node --env-file-if-exists=../.env src/dev/seed.ts"
  },
  "dependencies": {
    "@atproto/lex-client": "^0.3.6",
    "@atproto/lex-password-session": "^0.2.3",
    "@atproto/lex-schema": "^0.2.7",
    "@atproto/lex": "^0.3.11",
    "@bsky/sdk": "^1.1.3",
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^10.1.3",
    "better-sqlite3": "^12.2.0",
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.0",
    "typescript": "~5.8.3"
  }
}
